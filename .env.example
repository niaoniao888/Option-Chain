# Docker Compose reads this file after copying it to .env.
# Python itself does not auto-load .env. Use OS environment variables outside Docker.
OPTIONS_PORT=8780
OPTIONS_BASE_PATH=/options
OPTIONS_ALLOWED_HOSTS=127.0.0.1,localhost,options.example.com

# Optional US market data credentials. Set both via a secure deployment environment.
# Do not commit actual values. Windows can reuse current-user DPAPI if both are absent.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
